{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuzi.local/schemas/yuzi-beautify.schema.json",
  "title": "Yuzi Beautify Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "formatVersion", "manifest", "files"],
  "properties": {
    "format": { "const": "yuzi-beautify-preset" },
    "formatVersion": { "const": 1 },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "items"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "type": "string" },
        "version": { "type": "string" },
        "author": { "type": "string" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/item" } }
      }
    },
    "files": { "type": "object", "additionalProperties": { "$ref": "#/$defs/file" } }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "packagePath": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*[?#]).+$" },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mimeType", "encoding", "content"],
      "properties": {
        "mimeType": { "$ref": "#/$defs/nonEmptyString" },
        "encoding": { "enum": ["text", "base64"] },
        "content": { "type": "string" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableName", "fields"],
      "properties": {
        "tableName": { "$ref": "#/$defs/nonEmptyString" },
        "fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmptyString" } }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "html": { "$ref": "#/$defs/packagePath" },
        "css": { "$ref": "#/$defs/packagePath" },
        "js": { "$ref": "#/$defs/packagePath" },
        "scriptMode": { "enum": ["classic", "module"] }
      },
      "anyOf": [{ "required": ["html"] }, { "required": ["css"] }, { "required": ["js"] }]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "entry"],
      "properties": {
        "id": { "$ref": "#/$defs/nonEmptyString" },
        "name": { "type": "string" },
        "target": { "$ref": "#/$defs/target" },
        "entry": { "$ref": "#/$defs/entry" },
        "assets": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/packagePath" } }
      }
    }
  }
}
