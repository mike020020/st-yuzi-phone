{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yuzi.local/schemas/project.schema.json",
  "title": "Yuzi Beautify Source Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["tablesFile", "manifest", "files"],
  "properties": {
    "tablesFile": { "$ref": "#/definitions/projectPath" },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "author", "items"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "author": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/item" } }
      }
    },
    "files": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/packagePath" },
      "additionalProperties": { "$ref": "#/definitions/projectPath" }
    },
    "mimeTypes": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/packagePath" },
      "additionalProperties": { "type": "string", "minLength": 1, "pattern": "\\S" }
    },
    "encodings": {
      "type": "object",
      "propertyNames": { "$ref": "#/definitions/packagePath" },
      "additionalProperties": { "enum": ["text", "base64"] }
    }
  },
  "definitions": {
    "nonEmptyString": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\?#\\x00-\\x1F\\x7F])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!/)(?![A-Za-z]:)(?![A-Za-z][A-Za-z0-9+.-]*:)(?!.*[\\\\?#\\x00-\\x1F\\x7F])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//).+$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tableName", "fields"],
      "properties": {
        "tableName": { "$ref": "#/definitions/nonEmptyString" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/nonEmptyString" }
        }
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mount"],
      "properties": {
        "html": { "$ref": "#/definitions/packagePath" },
        "css": { "$ref": "#/definitions/packagePath" },
        "mount": { "$ref": "#/definitions/packagePath" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "entry", "assets"],
      "properties": {
        "id": { "$ref": "#/definitions/nonEmptyString" },
        "name": { "type": "string" },
        "target": { "$ref": "#/definitions/target" },
        "entry": { "$ref": "#/definitions/entry" },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/packagePath" }
        }
      }
    }
  }
}
